body {
    font-family: Arial;
    margin: 0;
    background: linear-gradient(to right, #ff7e5f, #feb47b);
    color: white;
}

header {
    background: rgba(0,0,0,0.7);
    padding: 15px;
    text-align: center;
}

nav a {
    margin: 10px;
    color: white;
    text-decoration: none;
    font-weight: bold;
}

.home {
    text-align: center;
    padding: 50px;
}

.home img {
    width: 150px;
    border-radius: 50%;
}

.card {
    background: white;
    color: black;
    padding: 15px;
    margin: 20px;
    border-radius: 10px;
}

.gallery img {
    width: 200px;
    margin: 10px;
    border-radius: 10px;
}
